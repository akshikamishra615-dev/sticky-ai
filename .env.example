# Database
DATABASE_URL="postgresql://user:password@host:port/database"

# Authentication
# Run `npx auth secret` or `openssl rand -base64 32` to generate a secret
AUTH_SECRET="your-auth-secret-here"

# Cloudinary Configuration for Image Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq AI Provider
GROQ_API_KEY="gsk_..."
GROQ_MODEL="openai/gpt-oss-20b"

# Storage (S3 / Cloudflare R2)
S3_BUCKET_NAME=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Base URL (Optional depending on hosting, required for some Auth.js versions)
# NEXTAUTH_URL="https://your-production-domain.com"
# AUTH_URL="https://your-production-domain.com"

# Upstash Redis for Rate Limiting & Background Workers
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
